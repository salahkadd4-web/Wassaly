rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profil privé : visible uniquement par son propriétaire.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'phone', 'role', 'photo', 'createdAt'])
        && request.resource.data.role in ['client', 'driver'];

      // Le rôle (et l'email) ne sont jamais modifiables depuis l'app.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'photo']);

      allow delete: if false;
    }

    // Profil public du livreur : lisible par tout utilisateur connecté.
    match /drivers/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'driver'
        && request.resource.data.active == false
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.subscriptionEnd > request.time
        && request.resource.data.subscriptionEnd
             < request.time + duration.value(62, 'd');

      // Le livreur ne peut pas toucher à son abonnement
      // et ne peut pas s'activer si son abonnement est expiré.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['active', 'latitude', 'longitude', 'lastLocationUpdate',
                       'city', 'name', 'phone', 'photo'])
        && (request.resource.data.active == false
            || resource.data.subscriptionEnd > request.time);

      allow delete: if false;
    }
  }
}
