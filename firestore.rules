rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrateur : document admins/{uid} cree a la main dans la console.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Livreur qui peut travailler (meme regle que functions/billing.js) :
    // piece validee, non suspendu, et essai / mois paye en cours, ou formule
    // "a la livraison" sans dette bloquante (1 000 DA).
    function driverEligible(d) {
      return d.get('verificationStatus', 'approved') == 'approved'
        && d.subscriptionStatus != 'suspended'
        && ((d.subscriptionStatus in ['trial', 'paid'] && d.subscriptionEnd > request.time)
            || (d.get('billingBlocked', false) != true
                && (d.subscriptionStatus == 'per_delivery'
                    || (d.subscriptionStatus in ['trial', 'paid']
                        && d.get('plan', '') == 'per_delivery'))));
    }

    function isSubscribedDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && driverEligible(get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data);
    }

    // Numero de mobile algerien dans un texte (05/06/07, +213, 00213 ; espaces,
    // points, tirets et chiffres arabes acceptes). Les numeros ne s'echangent
    // qu'apres l'acceptation d'une livraison. Meme motif que phone_guard.dart.
    function hasPhone(text) {
      return text is string
        && text.matches('(?s).*(0|٠|۰|[+]?213|00213)[ .-]*[5-7٥-٧۵-۷]([ .-]*[0-9٠-٩۰-۹]){8}.*');
    }

    // Textes libres d'une conversation sans numero de telephone.
    function convTextsClean() {
      return !hasPhone(request.resource.data.get('lastMessage', ''))
        && !hasPhone(request.resource.data.get('clientName', ''))
        && !hasPhone(request.resource.data.get('driverName', ''));
    }

    // Participant d'une conversation dont l'id est "clientId_driverId".
    function inConv(cid) {
      return signedIn()
        && (request.auth.uid == cid.split('_')[0]
            || request.auth.uid == cid.split('_')[1]);
    }

    // Un admin peut en nommer d'autres (par l'application) et en retirer,
    // sauf lui-meme. Le tout premier admin se cree a la main dans la console.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'addedBy', 'createdAt'])
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Unicite des numeros : un document par numero (id = numero normalise).
    // Creation seulement : si le numero existe deja, l'ecriture est refusee,
    // donc l'inscription entiere (ecriture groupee) echoue.
    match /phones/{phone} {
      allow read: if false;
      allow create: if signedIn()
        && phone.matches('^0[5-7][0-9]{8}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update, delete: if false;
    }

    // Profil prive : visible par son proprietaire et par l'administrateur.
    // C'est le seul endroit ou le numero de telephone est stocke.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'phone', 'role', 'photo', 'createdAt'])
        && request.resource.data.role in ['client', 'driver']
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0[5-7][0-9]{8}$')
        // Le numero doit etre reserve par ce meme compte dans phones/{numero}.
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phone)).data.uid == uid;

      // Le role, l'email et le numero ne sont jamais modifiables depuis l'application.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'photo'])
        && !hasPhone(request.resource.data.name);

      allow delete: if false;
    }

    // Profil public du livreur : lisible par tout utilisateur connecte.
    // Il ne contient PAS le numero de telephone (users/{uid}, prive) : client et
    // livreur ne l'obtiennent qu'apres l'acceptation d'une livraison.
    match /drivers/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'photo', 'active', 'city', 'latitude', 'longitude',
              'lastLocationUpdate', 'trialStart', 'subscriptionStatus',
              'subscriptionEnd', 'verificationStatus'])
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'driver'
        && !hasPhone(request.resource.data.name)
        && request.resource.data.active == false
        // Compte bloque jusqu'a la validation de la piece d'identite par l'admin.
        && request.resource.data.verificationStatus == 'pending'
        && getAfter(/databases/$(database)/documents/driverIdentity/$(uid)).data.idUrl is string
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.subscriptionEnd > request.time
        && request.resource.data.subscriptionEnd
             < request.time + duration.value(62, 'd');

      allow update: if
        // Le livreur : disponibilite, position (+ geohash pour la recherche
        // par zone), ville, identite. Il ne touche ni a son abonnement, ni a sa
        // formule, ni a sa dette, ni a sa note (Cloud Functions et admin), et ne
        // s'active que s'il peut travailler.
        (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['active', 'latitude', 'longitude', 'geohash',
                         'lastLocationUpdate', 'city', 'name', 'photo'])
          && !hasPhone(request.resource.data.name)
          && !hasPhone(request.resource.data.get('city', ''))
          && (request.resource.data.active == false || driverEligible(resource.data)))
        // Le livreur dont la piece a ete refusee peut la renvoyer (rejected -> pending).
        || (isOwner(uid)
          && resource.data.get('verificationStatus', 'approved') == 'rejected'
          && request.resource.data.verificationStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['verificationStatus']))
        // L'administrateur : tout, y compris l'abonnement.
        || isAdmin();

      allow delete: if false;
    }

    // Facturation du livreur : dette (formule a la livraison), compteurs
    // anti-fraude, historique. Ecrite par les Cloud Functions et l'admin.
    match /driverBilling/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();

      match /ledger/{entry} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Piece d'identite du livreur (URL Cloudinary) : privee, visible par le
    // livreur et l'administrateur uniquement.
    match /driverIdentity/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'idUrl', 'submittedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.idUrl is string
        && request.resource.data.idUrl.matches('^https://res\\.cloudinary\\.com/.+')
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'driver'
        && getAfter(/databases/$(database)/documents/drivers/$(uid)).data.verificationStatus == 'pending';

      allow update:
        // Le livreur renvoie une photo apres un refus.
        if (isOwner(uid)
            && get(/databases/$(database)/documents/drivers/$(uid)).data.verificationStatus == 'rejected'
            && request.resource.data.idUrl.matches('^https://res\\.cloudinary\\.com/.+')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['idUrl', 'submittedAt', 'rejectReason']))
        // L'administrateur : motif de refus uniquement.
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['rejectReason']));

      allow delete: if false;
    }

    // Conversations : id = clientId_driverId. Aucun numero de telephone ne
    // peut y circuler (messages, apercu, noms).
    match /conversations/{cid} {
      allow get: if inConv(cid);
      allow list: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || resource.data.driverId == request.auth.uid);

      allow create: if inConv(cid)
        && request.resource.data.clientId == cid.split('_')[0]
        && request.resource.data.driverId == cid.split('_')[1]
        && convTextsClean();

      allow update: if inConv(cid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clientName', 'driverName', 'lastMessage', 'lastSenderId',
                       'updatedAt', 'clientUnread', 'driverUnread'])
        && convTextsClean();

      allow delete: if false;

      match /messages/{mid} {
        allow read: if inConv(cid);
        allow create: if inConv(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && !hasPhone(request.resource.data.text);
        allow update, delete: if false;
      }
    }

    // Demandes de livraison.
    // L'acceptation passe par la Cloud Function acceptDelivery (debit de la
    // formule a la livraison) : le livreur ne peut pas passer lui-meme une
    // demande a "accepted".
    match /deliveryRequests/{rid} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || resource.data.driverId == request.auth.uid
            || isAdmin());

      allow create: if isOwner(request.resource.data.clientId)
        && request.resource.data.status == 'pending'
        && request.resource.data.note is string
        && !hasPhone(request.resource.data.note)
        && request.resource.data.keys().hasOnly(
             ['clientId', 'driverId', 'clientName', 'driverName',
              'pickup', 'delivery', 'note', 'status', 'createdAt', 'updatedAt']);

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'amount', 'completedAt'])
        && (
          // Le livreur refuse (sans toucher au montant)...
          (resource.data.driverId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'rejected'
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['amount', 'completedAt']))
          // ... ou termine la livraison acceptee. Le montant est le prix
          // convenu a l'acceptation (choisi dans la liste, ecrit par le serveur) ;
          // saisie libre seulement pour les anciennes demandes sans prix.
          || (resource.data.driverId == request.auth.uid
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'completed'
            && request.resource.data.amount is int
            && request.resource.data.amount >= 0
            && request.resource.data.amount <= 1000000
            && request.resource.data.amount
                 == resource.data.get('price', request.resource.data.amount)
            && request.resource.data.completedAt == request.time)
          // Le client peut annuler tant que ce n'est pas termine.
          || (resource.data.clientId == request.auth.uid
            && resource.data.status in ['pending', 'accepted']
            && request.resource.data.status == 'cancelled'
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['amount', 'completedAt']))
        );

      allow delete: if false;

      // Telephones des deux parties, ecrits par la Cloud Function a
      // l'acceptation et lisibles seulement une fois la demande acceptee.
      match /private/{doc} {
        allow read: if signedIn()
          && (isAdmin()
              || ((get(/databases/$(database)/documents/deliveryRequests/$(rid)).data.clientId == request.auth.uid
                   || get(/databases/$(database)/documents/deliveryRequests/$(rid)).data.driverId == request.auth.uid)
                  && get(/databases/$(database)/documents/deliveryRequests/$(rid)).data.status in ['accepted', 'completed']));
        allow write: if false;
      }
    }

    // Demandes ouvertes : publiees par un client, lues par les livreurs qui
    // peuvent travailler. Un livreur la prend via la Cloud Function
    // takeOpenRequest (statut "taken", elle devient une livraison suivie).
    match /openRequests/{rid} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || isAdmin()
            || (resource.data.status == 'open' && isSubscribedDriver()));

      allow create: if isOwner(request.resource.data.clientId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client'
        && request.resource.data.status == 'open'
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && !hasPhone(request.resource.data.note)
        && request.resource.data.keys().hasOnly(
             ['clientId', 'clientName', 'pickup', 'delivery',
              'note', 'status', 'createdAt', 'updatedAt']);

      // Le client peut seulement la cloturer, tant que personne ne l'a prise.
      allow update: if signedIn()
        && resource.data.clientId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // Jetons de notification push (FCM) des appareils d'un livreur.
    // Ecrits par l'application, lus et utilises par les Cloud Functions
    // (qui contournent ces regles).
    match /deviceTokens/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'lang', 'updatedAt'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 20
        && request.resource.data.lang in ['fr', 'ar'];
      allow delete: if isOwner(uid);
    }

    // Paiements declares par les livreurs (reference BaridiMob / CCP) :
    // "monthly" = un mois (+ dette eventuelle), "debt" = reglement de la dette.
    match /subscriptionRequests/{sid} {
      allow read: if signedIn()
        && (resource.data.driverId == request.auth.uid || isAdmin());

      allow create: if isOwner(request.resource.data.driverId)
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['monthly', 'debt']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000
        && request.resource.data.keys().hasOnly(
             ['driverId', 'driverName', 'driverPhone', 'reference', 'referenceKey',
              'status', 'kind', 'amount', 'createdAt'])
        // La reference est reservee pour CETTE declaration dans paymentRefs
        // (meme ecriture groupee) : une reference ne sert qu'une fois.
        && getAfter(/databases/$(database)/documents/paymentRefs/$(request.resource.data.referenceKey)).data.claimId == sid;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt']);

      allow delete: if false;
    }

    // Reference de paiement deja utilisee (id = reference normalisee :
    // majuscules, lettres et chiffres). Creation seulement : si la reference
    // existe, l'ecriture est refusee, donc la declaration aussi. L'admin peut
    // supprimer une reservation saisie par erreur (console).
    match /paymentRefs/{key} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && key.matches('^[A-Z0-9]{4,40}$')
        && request.resource.data.keys().hasOnly(['driverId', 'claimId', 'createdAt'])
        && request.resource.data.driverId == request.auth.uid
        && getAfter(/databases/$(database)/documents/subscriptionRequests/$(request.resource.data.claimId)).data.driverId == request.auth.uid
        && getAfter(/databases/$(database)/documents/subscriptionRequests/$(request.resource.data.claimId)).data.referenceKey == key;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Note d'une livraison terminee (id = id de la livraison) : une seule, par
    // le client de cette livraison. La moyenne est calculee par le serveur.
    match /ratings/{rid} {
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.clientId == request.auth.uid
                || resource.data.driverId == request.auth.uid));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['clientId', 'driverId', 'stars', 'comment', 'createdAt'])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 300
        && !hasPhone(request.resource.data.comment)
        && get(/databases/$(database)/documents/deliveryRequests/$(rid)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/deliveryRequests/$(rid)).data.driverId == request.resource.data.driverId
        && get(/databases/$(database)/documents/deliveryRequests/$(rid)).data.status == 'completed';

      allow update, delete: if false;
    }

    // Signalement d'un livreur par un client : un seul par couple
    // (id = clientId_driverId), et seulement apres un echange (conversation ou
    // demande de livraison entre eux). Lu par l'admin (onglet Suspects).
    match /reports/{rid} {
      allow read: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.driverId
        && request.resource.data.keys().hasOnly(
             ['clientId', 'driverId', 'reason', 'note', 'requestId', 'createdAt'])
        && request.resource.data.reason in ['off_app', 'not_delivered', 'behavior', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && (exists(/databases/$(database)/documents/conversations/$(rid))
            || ('requestId' in request.resource.data
                && get(/databases/$(database)/documents/deliveryRequests/$(request.resource.data.requestId)).data.clientId == request.auth.uid
                && get(/databases/$(database)/documents/deliveryRequests/$(request.resource.data.requestId)).data.driverId == request.resource.data.driverId));

      allow update, delete: if false;
    }
  }
}
